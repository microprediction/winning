\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Per-prompt scores over nine thousand held-out Bernoulli outcomes. The plug-in's log loss is dominated by zero-training- success prompts that succeed in the held-out half; the posterior predictive prices those prompts at their shrunken posterior rate instead of zero. The two prior families tie.}}{5}{table.1}\protected@file@percent }
\newlabel{tab:perprompt}{{1}{5}{Per-prompt scores over nine thousand held-out Bernoulli outcomes. The plug-in's log loss is dominated by zero-training- success prompts that succeed in the held-out half; the posterior predictive prices those prompts at their shrunken posterior rate instead of zero. The two prior families tie}{table.1}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Aggregate pass@$k$ extrapolated from four samples per prompt, against the estimator of \citet  {chen2021} on all eight. The plug-in's downward bias grows with $k$ as Proposition~\ref {prop:bias} requires, reaching thirteen points absolute at $k=8$; the posterior predictives land within two points. By Proposition~\ref {prop:bayes}(iii) these aggregate rows also measure the population estimator of \citet  {kazdan2025} under the same fitted priors; the per-prompt scores of Table~\ref {tab:perprompt} are what conditioning adds beyond it.}}{5}{table.2}\protected@file@percent }
\newlabel{tab:aggregate}{{2}{5}{Aggregate pass@$k$ extrapolated from four samples per prompt, against the estimator of \citet {chen2021} on all eight. The plug-in's downward bias grows with $k$ as Proposition~\ref {prop:bias} requires, reaching thirteen points absolute at $k=8$; the posterior predictives land within two points. By Proposition~\ref {prop:bayes}(iii) these aggregate rows also measure the population estimator of \citet {kazdan2025} under the same fitted priors; the per-prompt scores of Table~\ref {tab:perprompt} are what conditioning adds beyond it}{table.2}{}}

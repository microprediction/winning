\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Aggregate pass@$k$ extrapolated from four samples per prompt, against the unbiased estimator of \citet  {chen2021} on all eight. The plug-in's downward bias grows with $k$ as Proposition~\ref {prop:bias} requires, reaching thirteen points absolute at $k=8$; the posterior predictives land within two points.}}{4}{table.2}\protected@file@percent }
\newlabel{tab:aggregate}{{2}{4}{Aggregate pass@$k$ extrapolated from four samples per prompt, against the unbiased estimator of \citet {chen2021} on all eight. The plug-in's downward bias grows with $k$ as Proposition~\ref {prop:bias} requires, reaching thirteen points absolute at $k=8$; the posterior predictives land within two points}{table.2}{}}

cholarworks.iu.edu/iuswrrest/api/core/items/c469aae3-ec29-4c3f-a355-b93e53e41d77/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/c469aae3-ec29-4c3f-a355-b93e53e41d77/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/c469aae3-ec29-4c3f-a355-b93e53e41d77/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/c469aae3-ec29-4c3f-a355-b93e53e41d77/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/c469aae3-ec29-4c3f-a355-b93e53e41d77/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/c469aae3-ec29-4c3f-a355-b93e53e41d77/thumbnail&q;},&q;self&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/c469aae3-ec29-4c3f-a355-b93e53e41d77&q;}},&q;_name&q;:&q;Torts: Cases, Problems, and Policy Choices&q;,&q;id&q;:&q;c469aae3-ec29-4c3f-a355-b93e53e41d77&q;,&q;uuid&q;:&q;c469aae3-ec29-4c3f-a355-b93e53e41d77&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;77a50ae7-bf2f-4fc7-b3f5-cb3d044cd44e&q;,&q;language&q;:null,&q;value&q;:&q;Lubin, Asaf&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;ac4e34b2-6e6c-4571-bcf8-e9f11e9326ad&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-17T19:18:08Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;e84a84a5-c8f4-4d0f-b3bd-266c9bfc2ac0&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-13T17:24:11Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;a296dfbd-d981-45d3-894c-3839570750af&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-17T19:18:08Z&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;2d6c543c-72b1-4161-847e-0376173ca28a&q;,&q;language&q;:null,&q;value&q;:&q;2026-05-13&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;58a7065b-ae4a-4f64-a48f-d676707a0789&q;,&q;language&q;:null,&q;value&q;:&q;This casebook offers a sustained examination of private law remedies for harms arising from both intentional and accidental conduct. It explores the legal institutions, doctrines, and judgments through which courts and legislatures allocate responsibility when one person’s conduct injures another. At its center is a basic but enduring question: when, and on what terms, may one private citizen compel another to provide monetary redress?\n\nTort litigation turns on a complex interplay of doctrine, theory, and policy: the elements a plaintiff must prove, the principles that justify liability, and the considerations that shape the scope of recovery. This casebook examines each of these dimensions through the cases, controversies, and recurring problems that have defined the law of torts. Alongside foundational decisions, readers will encounter the occasional anachronism, doctrinal oddity, and legal relic. Some rules have fallen out of favor. Others are making a comeback. The quirkiness of tort law is not confined to doctrine. Its facts often form a parade of the improbable: shoppers slipping on rogue pizza slices in a Target aisle, municipalities sued over monkeys escaping from understaffed zoos, and countless other accidents in which ordinary life turns unexpectedly litigious. Yet beneath these eccentric settings lie some of the law’s most serious questions: how to determine causation, when to recognize a duty of care, and how far responsibility should extend in everyday life.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:0}],&q;dc.description.sponsorship&q;:[{&q;uuid&q;:&q;e7d1fd03-67df-41bd-9f8a-53e53781334b&q;,&q;language&q;:null,&q;value&q;:&q;Course Materials Fellowship&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;e0ab13e1-599d-4858-a6fe-6f0dacb71bfd&q;,&q;language&q;:null,&q;value&q;:&q;https://hdl.handle.net/2022/34845.2&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;9fb8c7f6-563a-4266-99df-9ebd83b82bef&q;,&q;language&q;:null,&q;value&q;:&q;en_US&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;445c08b8-20c7-4ba4-b220-8a8d08731b9c&q;,&q;language&q;:null,&q;value&q;:&q;IU Libraries&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.isversionof&q;:[{&q;uuid&q;:&q;2cdb872e-dae2-4937-aad1-143940e19a46&q;,&q;language&q;:null,&q;value&q;:&q;https://opencasebook.org/casebooks/15286/&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights&q;:[{&q;uuid&q;:&q;c4a06887-7bcc-4652-8611-c3b2dacc7f7b&q;,&q;language&q;:null,&q;value&q;:&q;This work is licensed under CC BY-NC: You are free to copy and redistribute the material in any format, as well as remix, transform, and build upon the material as long as you give appropriate credit to the original creator, provide a link to the license, and indicate any changes made. You may not use this work for commercial purpose.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.uri&q;:[{&q;uuid&q;:&q;5e5046b1-20ea-4a42-8ef6-e316ef383f49&q;,&q;language&q;:null,&q;value&q;:&q;http://creativecommons.org/licenses/by-nc/4.0/&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.title&q;:[{&q;uuid&q;:&q;c9bcdb03-10a3-4828-ade3-0c5eb47040ac&q;,&q;language&q;:null,&q;value&q;:&q;Torts: Cases, Problems, and Policy Choices&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.type&q;:[{&q;uuid&q;:&q;96833c17-3909-4336-967b-b07398fd66a0&q;,&q;language&q;:null,&q;value&q;:&q;Book&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}]}},&q;timeCompleted&q;:1787003597465,&q;msToLive&q;:900000,&q;requestUUIDs&q;:[&q;client/2609238f-17f1-4f42-ba7e-9dfcf34bd98c&q;],&q;dependentRequestUUIDs&q;:[],&q;isDirty&q;:false,&q;patches&q;:[],&q;alternativeLinks&q;:[]},&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/thumbnail&q;:{&q;data&q;:null,&q;timeCompleted&q;:1787003597465,&q;msToLive&q;:900000,&q;requestUUIDs&q;:[&q;client/2609238f-17f1-4f42-ba7e-9dfcf34bd98c&q;],&q;dependentRequestUUIDs&q;:[],&q;isDirty&q;:false,&q;patches&q;:[],&q;alternativeLinks&q;:[&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/thumbnail&q;]},&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67&q;:{&q;data&q;:{&q;handle&q;:&q;2022/38535&q;,&q;lastModified&q;:&q;2026-08-17T17:43:42.117Z&q;,&q;isArchived&q;:true,&q;isDiscoverable&q;:true,&q;isWithdrawn&q;:false,&q;_links&q;:{&q;accessStatus&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/accessStatus&q;},&q;bundles&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/bundles&q;},&q;identifiers&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/identifiers&q;},&q;mappedCollections&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/mappedCollections&q;},&q;owningCollection&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/owningCollection&q;},&q;relationships&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/relationships&q;},&q;version&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/version&q;},&q;templateItemOf&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/templateItemOf&q;},&q;thumbnail&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67/thumbnail&q;},&q;self&q;:{&q;href&q;:&q;https://scholarworks.iu.edu/iuswrrest/api/core/items/f765527b-83b1-4c92-b4ab-2e50857d8e67&q;}},&q;_name&q;:&q;Interpreting Anti-Boycott Laws in the Shadow of the First Amendment&q;,&q;id&q;:&q;f765527b-83b1-4c92-b4ab-2e50857d8e67&q;,&q;uuid&q;:&q;f765527b-83b1-4c92-b4ab-2e50857d8e67&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;d74c1fe1-07ce-4b26-a894-9f35d4cc1e19&q;,&q;language&q;:null,&q;value&q;:&q;Tomain, Joseph A.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;b2dfcab8-b1ba-4f28-8f3a-1382f367224b&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-17T17:43:42Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;d3144287-14fa-4249-a7fd-685fcb47025c&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-17T17:43:42Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;f1aeaa1f-906f-4c39-9d7c-f2dce8624093&q;,&q;language&q;:null,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description&q;:[{&q;uuid&q;:&q;7f65a0be-d2d3-490d-99a2-8b9c9cdfe666&q;,&q;language&q;:null,&q;value&q;:&q;As of 8/17/2026, there were 0 downloads from the previous repository platform.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;76d4a0b9-6936-4be8-8f54-2b8da19e61a2&q;,&q;language&q;:null,&q;value&q;:&q;Thirty-eight states have enacted “anti-BDS” laws. These laws require people or entities doing business with the state to certify that they do not participate in the Boycott Divestment Sanction movement against Israel. Typically, these laws define boycott as a “refusal to deal, terminating business, or other actions” that limit commercial relations with Israel or Israeli entities. It is highly contested in the courts and commentary whether these anti-boycott laws violate the First Amendment. Assuming arguendo that the “refusal to deal” and “terminating business” clauses do not implicate the First Amendment, that leaves the residual clause. At least one court and one commentator find that the “or other actions” clause does not implicate the First Amendment by applying the canon of statutory construction, ejusdem generis. Ejusdem generis looks to the specifically listed items that precede the residual clause to define and often limit its scope. This semantic canon of statutory construction is centuries old and still actively used today. In the October 2023 Term, the Supreme Court discussed ejusdem generis in four cases.\nBut the First Amendment issue raised by these anti-boycott statutes cannot be avoided simply by invoking ejusdem generis because semantic canons cannot be used to contradict a statute. A statute-by-statute analysis is required to determine whether ejusdem generis can be properly applied to the residual clause of these laws. To avoid the intractable debate about the use of legislative history, I reach this conclusion by focusing on anti-BDS laws that include enacted legislative findings, statutory definitions of “boycott,” and clauses that expressly exclude speech from their coverage. This analysis shows that applying ejusdem generis to some anti-BDS laws may contradict the statutes whereas applying it to other statutes may honor them.\nIn all instances, however, the context of each statute must be individually analyzed to determine the propriety of applying ejusdem generis. In addition to analyzing statutory text, Supreme Court cases applying ejusdem generis are analyzed, including four cases from the October 2023 Term Moreover, these anti-BDS laws are being used as a template for anti-boycott laws in other contexts, such as fossil fuels, firearms, and economic boycotts generally. Thus, this Article’s relevance transcends the BDS context and raises important and timely questions regarding the intersection of statutory interpretation and the First Amendment.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.citation&q;:[{&q;uuid&q;:&q;47e4c2bd-0cac-4ecd-b203-ed05acee07d9&q;,&q;language&q;:null,&q;value&q;:&q;36 U. Fla. J. L. &a; Pub. Pol&s;y 293 (2026)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;b3334554-a1cb-4814-9413-799a210479d7&q;,&q;language&q;:null,&q;value&q;:&q;https://hdl.handle.net/2022/38535&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;3622ed37-00cb-47a4-a030-3df4e4693ad3&q;,&q;language&q;:null,&q;value&q;:&q;en_US&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;303374f3-c2d9-4117-bfa3-10bf7d6242b4&q;,&q;language&q;:null,&q;value&q;:&q;University of Florida Journal of Law &a; Public Policy&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.journal&q;:[{&q;uuid&q;:&q;7dec3c41-bbc2-4e5f-b4d5-bfae0335a1cc&q;,&q;language&q;:null,&q;value&q;:&q;University of Florida Journal of Law &a; Public Policy&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights&q;:[{&q;uuid&q;:&q;3c4b8050-69f4-4749-914d-0402c0a03ea9&q;,&q;language&q;:null,&q;value&q;:&q;This work is protected by copyright unless stated otherwise.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.uri&q;:[{&q;uuid&q;:&q;b3475b21-4233-4171-ae33-eb00e70f6b38&q;,&q;language&q;:null,&q;value&q;:&q;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.subject&q;:[{&q;uuid&q;:&q;599bc55b-c430-49a9-8584-344a2063ce54&q;,&q;language&q;:null,&q;value&q;:&q;Stautory Interpretation&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;c6498ddf-8811-4cfb-847c-0a1e7ca5dd25&q;,&q;language&q;:null,&q;value&q;:&q;First Amendment&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;77055428-01b8-47c2-a
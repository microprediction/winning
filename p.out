dc.contributor.author&q;:[{&q;uuid&q;:&q;2f7f7935-ada9-4809-97ae-e991dc0af965&q;,&q;language&q;:null,&q;value&q;:&q;Butler, Yvette&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;0df3ff2b-4848-4c17-ae64-56e1e1b8383e&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-13T20:09:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;ac1a7ee0-dbda-4286-9775-2da146a921ee&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-13T20:09:18Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;a55319d9-fe2d-423a-83f2-a05365af28f2&q;,&q;language&q;:null,&q;value&q;:&q;2021&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description&q;:[{&q;uuid&q;:&q;c709f0c2-ddda-41f6-80c5-6c2e444530dc&q;,&q;language&q;:null,&q;value&q;:&q;As of 8/13/2026, there were 405 downloads from the previous repository platform.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;25ddff5d-d677-4334-be94-5331fbd35d0e&q;,&q;language&q;:null,&q;value&q;:&q;Society’s perception of a type of work and the people who engage in money-generating activities has an impact on whether and how the law protects (or does not protect) the people who perform those activities. Work can be legitimized or delegitimized. Workers are protected or left out to dry depending upon their particular “hustle.” This Article argues that gig workers and sex workers face similar challenges within the legal system and that these groups can and should collaborate to their collective advantage when seeking reforms. Gig workers have been gaining legitimacy while sex workers still primarily operate in the shadow economy. This Article digs into the sometimes-conflicting desires of individuals working as sex workers and gig workers to inform how gig workers can achieve the power and economic independence necessary to prevent workplace exploitation.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.citation&q;:[{&q;uuid&q;:&q;d0d795aa-1c74-4b0a-a27d-73575b4b144a&q;,&q;language&q;:null,&q;value&q;:&q;26 Michigan Journal of Race &a; Law 337 (2021)&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;5e64badd-c9d5-4b47-9c54-fbbe4f2eceba&q;,&q;language&q;:null,&q;value&q;:&q;https://hdl.handle.net/2022/38532&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;6e92bdf2-26d2-414d-bc46-951472bc5cfc&q;,&q;language&q;:null,&q;value&q;:&q;en_US&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.publisher&q;:[{&q;uuid&q;:&q;f6d0becc-51d0-4675-b5a0-a4ef33b87688&q;,&q;language&q;:null,&q;value&q;:&q;Michigan Journal of Race &a; Law&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.relation.journal&q;:[{&q;uuid&q;:&q;21a94e76-2156-4242-af67-1bc25947063e&q;,&q;language&q;:null,&q;value&q;:&q;Michigan Journal of Race &a; Law&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights&q;:[{&q;uuid&q;:&q;112ca1a8-3398-47cc-ba73-f4cabb0702df&q;,&q;language&q;:null,&q;value&q;:&q;This work is protected by copyright unless stated otherwise.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights.uri&q;:[{&q;uuid&q;:&q;7dec263e-7fbf-4097-b00e-fa7d56958f01&q;,&q;language&q;:null,&q;value&q;:&q;&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.subject&q;:[{&q;uuid&q;:&q;ce3c0734-b576-43a9-8a98-2a0cec6ec59c&q;,&q;language&q;:null,&q;value&q;:&q;sex work&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;dc2798dc-aa59-4639-81fc-c6426fb0d422&q;,&q;language&q;:null,&q;value&q;:&q;sex trade&q;,&q;place&q;:1,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid&q;:&q;322ed095-dbf0-4026-bd8f-a9acd7dc6ec0&q;,&q;language&q;:null,&q;value&q;:&q;trafficking&q;,&q;place&q;:2,&q;authority&q;:null,&q;confidence&q;:-1},{&q;uuid
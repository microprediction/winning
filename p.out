nguage&q;:null,&q;value&q;:&q;2026-08-16T20:59:53Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;72445083-6712-47e1-871a-bf566868db9f&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-16T20:59:53Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;5481ca92-7cd9-423b-a0d6-8c6f33e8da5a&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-16&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description&q;:[{&q;uuid&q;:&q;80b750c0-0bd7-4743-8154-fc0132ff6bfc&q;,&q;language&q;:null,&q;value&q;:&q;This 75-minute lesson uses a low-stakes, student-centered format in the style of the popular TV show, \&q;Shark Tank,\&q; to transform an end-of-semester reflection into an opportunity for students to become partners in course design. Students collaboratively evaluate and redesign an existing in-class assignment, justify their design choices, and pitch their revisions to their peers and instructors. Through the process, students reflect on their own learning while developing an understanding of learning outcomes, engagement, and effective assignment design.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.identifier.uri&q;:[{&q;uuid&q;:&q;7a60e7a3-5b62-4f9d-b49a-76b3eb414d4d&q;,&q;language&q;:null,&q;value&q;:&q;https://hdl.handle.net/2022/38533&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.language.iso&q;:[{&q;uuid&q;:&q;bb2fa3e5-4b47-42d1-abd2-4bb316742ab3&q;,&q;language&q;:null,&q;value&q;:&q;en_US&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.rights&q;:[{&q;uuid&q;:&q;93b079c3-4f01-45ed-91f1-627c3b6d48d4&q;,&q;language&q;:null,&q;value&q;:&q;This work is licensed under CC BY-NC-SA: You are free to copy and redistribute the material in any format as well as remix, transform, and build upon the material as long as you give appropriate credit to the original creator, provide a link to the license, and indicate any chan
b9a2901769&q;,&q;type&q;:&q;item&q;,&q;metadata&q;:{&q;dc.contributor.author&q;:[{&q;uuid&q;:&q;e1e3a6f5-a9cb-49a4-b8c0-ee528b11bc58&q;,&q;language&q;:null,&q;value&q;:&q;Tomain, Joseph A.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.accessioned&q;:[{&q;uuid&q;:&q;3e478994-297e-4034-b019-46ccab005ce3&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-17T17:34:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.available&q;:[{&q;uuid&q;:&q;94beba49-b21f-4896-9cbd-285216fd2a41&q;,&q;language&q;:null,&q;value&q;:&q;2026-08-17T17:34:20Z&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.date.issued&q;:[{&q;uuid&q;:&q;46e84f44-3083-44e1-a49a-ac0344ef5f34&q;,&q;language&q;:null,&q;value&q;:&q;2026&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description&q;:[{&q;uuid&q;:&q;6b5b0e10-b67d-47f3-ba8b-bd582207c8fa&q;,&q;language&q;:null,&q;value&q;:&q;As of 8/17/2026, there were 0 downloads from the previous repository platform.&q;,&q;place&q;:0,&q;authority&q;:null,&q;confidence&q;:-1}],&q;dc.description.abstract&q;:[{&q;uuid&q;:&q;8bde277b-9411-4482-8564-cc308ce820af&q;,&q;language&q;:null,&q;value&q;:&q;Defending dissent to safeguard speech and political opposition is a challenging and necessary task for a self-governing democracy. Moreover, it is a collective task. Succeeding in this endeavor sometimes requires defending speech with which one disagrees, especially in a nation as pluralistic as the United States. Although imperfect and inconsistent, there are numerous examples where strange bedfellows join together to achieve this goal. While First Amendment law helps us reach the goal, law alone is not enough. We also need a cultural commitment to defending dissent. This Essay argues that cultivating a culture that values robust free speech protection is an essential component to ensuring our grand and wobbly experiment in democracy moves forward in a positive trajectory.&q;,&q;place&q;:0,&q;aut